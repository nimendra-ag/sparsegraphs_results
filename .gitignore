.venv
.idea
datasets
*.png

**/__pycache__/
cm/
# large sparse-code cache (exceeds GitHub 100MB limit)
# needs the **/ prefix: a pattern with a slash is anchored to the repo root,
# so plain "code_cache/sparse_codes.npz" never matched artifacts/<run>/code_cache/
**/code_cache/sparse_codes.npz

# wl_edge AK-SVD dictionaries: 136MB-2.1GB each, over GitHub's 100MB hard limit.
# Smaller aksvd_dictionary.npy files (wl_aksvd, gspan_cork_aksvd) stay tracked,
# so ignore only this run family rather than the filename everywhere.
artifacts/wl_edge_aksvd_*/dict_learner/aksvd_dictionary.npy

# LC-KSVD solver state: 128MB+ per run, over GitHub's 100MB hard limit.
# The learned lcksvd_dictionary.npy (55MB) stays tracked -- only the resumable
# solver state is dropped, so runs stay reproducible from the dictionary alone.
artifacts/wl_lcksvd_*/dict_learner/lcksvd_state.npz

# wl_edge FDDL dictionaries: 125MB-1.6GB each, over GitHub's 100MB hard limit.
# Smaller fddl_D.npy files (wl_fddl, wl_csfddl, and wl_edge atoms1024 at 67MB)
# stay tracked, so ignore only the oversized runs rather than the filename.
artifacts/wl_edge_fddl_gpu_nci_full_atoms24000_*/dict_learner/fddl_D.npy
artifacts/wl_edge_fddl_gpu_nci_full_atoms20000_*/dict_learner/fddl_D.npy
artifacts/wl_edge_fddl_gpu_nci_full_atoms8192_*/dict_learner/fddl_D.npy
artifacts/wl_edge_fddl_gpu_nci_full_id33_atoms2048_*/dict_learner/fddl_D.npy
